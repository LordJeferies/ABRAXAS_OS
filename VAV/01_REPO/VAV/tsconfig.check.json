{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "typeRoots": [
      "./node_modules/@types",
      "./node_modules"
    ],
    "paths": {
      "react": [
        "./node_modules/@types/react"
      ],
      "react-dom": [
        "./node_modules/@types/react-dom"
      ],
      "react-dom/server": [
        "./node_modules/@types/react-dom/server"
      ],
      "react/jsx-runtime": [
        "./node_modules/@types/react/jsx-runtime"
      ],
      "react/jsx-dev-runtime": [
        "./node_modules/@types/react/jsx-dev-runtime"
      ],
      "vitest": [
        "./node_modules/vitest/dist/index.d.ts"
      ]
    },
    "types": [
      "node",
      "vitest"
    ]
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "services/**/*.ts",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "../../../ABRAXAS_CORE/HE/**/*.ts",
    "../../../ABRAXAS_CORE/HE/**/*.tsx",
    "../../../ABRAXAS_CORE/LIENZO/**/*.ts",
    "../../../ABRAXAS_CORE/backbone/**/*.ts",
    "../../../ABRAXAS_CORE/YOD/runtime/**/*.ts",
    "../../../ABRAXAS_CORE/SHIM/**/*.ts",
    "../../../ABRAXAS_CORE/vav-bridge/**/*.ts",
    "../../../ABRAXAS_CORE/ARQUITECTO/**/*.ts",
    "../../../ABRAXAS_CORE/ai-runtime/**/*.ts",
    "../../../ABRAXAS_CORE/intake/**/*.ts",
    "../../../ABRAXAS_CORE/pipeline/**/*.ts",
    "../../../ABRAXAS_CORE/publishing/**/*.ts",
    "../../../ABRAXAS_CORE/metrics/**/*.ts",
    "../../../ABRAXAS_CORE/learning/**/*.ts",
    "../../../ABRAXAS_CORE/automation/**/*.ts",
    "../../../ABRAXAS_CORE/jobs/**/*.ts",
    "../../../ABRAXAS_CORE/health/**/*.ts",
    "../../../ABRAXAS_CORE/recovery/**/*.ts",
    "../../../ABRAXAS_CORE/scale-projections/**/*.ts",
    "../../../ABRAXAS_CORE/contracts/container-readiness/**/*.ts",
    "../../../ABRAXAS_CORE/contracts/pipeline/**/*.ts",
    "../../../ABRAXAS_CORE/tests/**/*.ts",
    "../../../apps/public-status/tests/**/*.ts"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "apps/captions-desktop/src-tauri/**"
  ]
}
