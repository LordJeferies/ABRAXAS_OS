{
  "name": "vav",
  "version": "0.0.1-dev",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build-abraxas": "node ../../../scripts/build-abraxas.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "build": "pnpm --filter @vav/captions-desktop build",
    "engine:health": "pnpm --filter @vav/local-engine health",
    "providers:discover": "node scripts/discover-providers.mjs",
    "tauri:dev": "pnpm --filter @vav/captions-desktop tauri dev",
    "tauri:build": "pnpm --filter @vav/captions-desktop tauri build",
    "foundation:health": "node scripts/check-pro-foundation.mjs",
    "bridge:health": "node scripts/check-content-motion-bridge.mjs",
    "cuts:health": "node scripts/check-cuts-foundation.mjs",
    "motions:health": "node scripts/check-motions-foundation.mjs",
    "he:dev": "vite -c vite.config.he.ts",
    "he:build": "vite build -c vite.config.he.ts",
    "he:preview": "vite preview -c vite.config.he.ts",
    "status:build": "node scripts/build-public-status.mjs",
    "verification:generate": "node scripts/generate-release-verification.mjs"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "8.2.2",
    "@vitejs/plugin-react": "6.1.0"
  }
}