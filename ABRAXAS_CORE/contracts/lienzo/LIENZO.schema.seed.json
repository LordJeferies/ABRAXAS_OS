{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ABRAXAS Lienzo Seed",
  "type": "object",
  "required": [
    "content_id",
    "client_id",
    "lifecycle",
    "components",
    "history"
  ],
  "properties": {
    "content_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "plan_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "format_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "structure_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "lifecycle": {
      "enum": [
        "IDEA",
        "PLANNED",
        "PREPRODUCTION",
        "RECORDING",
        "INGESTED",
        "RESOLVED",
        "PRODUCTION",
        "QA",
        "READY",
        "SCHEDULED",
        "PUBLISHED",
        "LEARNING",
        "ARCHIVED"
      ]
    },
    "general": {
      "type": "object"
    },
    "strategy": {
      "type": "object"
    },
    "planned": {
      "type": "object"
    },
    "observed": {
      "type": "object"
    },
    "resolved": {
      "type": "object"
    },
    "copy": {
      "type": "object"
    },
    "visual": {
      "type": "object"
    },
    "production": {
      "type": "object"
    },
    "publication_targets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "metrics": {
      "type": "object"
    },
    "components": {
      "type": "object"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
